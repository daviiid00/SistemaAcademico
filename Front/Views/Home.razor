@page "/"
@rendermode InteractiveServer
@inject AcademicoFacadeService Facade

<PageTitle>Inicio — Sistema Académico Universitario</PageTitle>

<!-- ═══════════════════════════════════════════════════════
     HERO SECTION — Fondo oscuro elegante
     ═══════════════════════════════════════════════════════ -->
<section class="hero">
    <!-- Círculos decorativos de fondo -->
    <div class="hero-bg-circle hero-bg-circle-1"></div>
    <div class="hero-bg-circle hero-bg-circle-2"></div>

    <div class="hero-content">
        <!-- Texto principal -->
        <div class="animate-fade-in-up">
            <span class="hero-badge">Sistema Académico Universitario</span>

            <h1 class="hero-title">
                Gestión académica<br /><span>inteligente y moderna</span>
            </h1>

            <p class="hero-desc">
                Plataforma institucional para la administración completa de
                estudiantes, docentes, asignaturas y evaluaciones. Construida
                sobre principios de arquitectura limpia y POO avanzada.
            </p>

            <div class="hero-actions">
                <a href="/estudiantes" class="btn btn-primary btn-lg">
                    Ver Estudiantes
                    <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                    </svg>
                </a>
                <a href="/evaluaciones" class="btn btn-white btn-lg">
                    Registrar Evaluación
                </a>
            </div>

            <!-- Estadísticas rápidas -->
            <div class="hero-stats">
                <div>
                    <div class="hero-stat-num">@Stats.TotalEstudiantes</div>
                    <div class="hero-stat-lab">Estudiantes</div>
                </div>
                <div>
                    <div class="hero-stat-num">@Stats.TotalDocentes</div>
                    <div class="hero-stat-lab">Docentes</div>
                </div>
                <div>
                    <div class="hero-stat-num">@Stats.TotalAsignaturas</div>
                    <div class="hero-stat-lab">Asignaturas</div>
                </div>
                <div>
                    <div class="hero-stat-num">@Stats.TotalEvaluaciones</div>
                    <div class="hero-stat-lab">Evaluaciones</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════════════════════
     SECCIÓN: En nuestro sistema...
     ═══════════════════════════════════════════════════════ -->
<section class="section bg-light">
    <div class="container">
        <div class="text-center mb-12 reveal">
            <span class="section-label">Nuestros Módulos</span>
            <h2 class="section-title">En nuestro sistema somos...</h2>
            <p class="section-subtitle" style="margin:0 auto;">
                Una plataforma académica completa que gestiona el ciclo de vida
                de la información universitaria con tecnología de vanguardia.
            </p>
        </div>

        <div class="cards-grid-3">
            <ModuloCard
                Href="/estudiantes"
                Titulo="Conexiones que transforman"
                Descripcion="Gestión completa de estudiantes de Pregrado y Posgrado con historial académico, promedios y requisitos de grado."
                Color="blue"
                Delay="1"
                Icon="academic-cap" />

            <div class="card-imagen-central reveal animate-delay-2">
                <div style="background:linear-gradient(135deg,#1a56db,#3b82f6); border-radius:1rem; height:300px; display:flex; align-items:center; justify-content:center;">
                    <div style="text-align:center; color:white; padding:2rem;">
                        <div style="font-size:4rem; font-weight:900; letter-spacing:-0.05em; margin-bottom:0.5rem;">POO</div>
                        <div style="font-size:1rem; opacity:0.8;">Programación Orientada a Objetos</div>
                        <div style="margin-top:1.5rem; font-size:0.8rem; opacity:0.6; line-height:1.8;">
                            Observer Pattern<br/>Dependency Injection<br/>Result&lt;T&gt; Pattern<br/>Polimorfismo
                        </div>
                    </div>
                </div>
            </div>

            <ModuloCard
                Href="/evaluaciones"
                Titulo="Excelencia Académica"
                Descripcion="Sistema de evaluaciones y seguimiento de permanencia con notificaciones inteligentes mediante el patrón Observer."
                Color="blue"
                Delay="3"
                Icon="chart" />
        </div>
    </div>
</section>


<section class="section bg-white">
    <div class="container">
        <div class="mb-12 reveal">
            <span class="section-label">Acceso Rápido</span>
            <h2 class="section-title">Todos los módulos</h2>
            <p class="section-subtitle">
                Navega directamente a la sección que necesitas.
            </p>
        </div>

        <div class="cards-grid">
            <ModuloCard Href="/estudiantes"    Titulo="Estudiantes"   Descripcion="Pregrado y Posgrado, historial académico y requisitos de grado."                Color="white" Delay="1" Icon="academic-cap" />
            <ModuloCard Href="/docentes"       Titulo="Docentes"      Descripcion="Gestión de docentes, sus títulos, área de enseñanza y asignaturas."             Color="white" Delay="2" Icon="user"         />
            <ModuloCard Href="/asignaturas"    Titulo="Asignaturas"   Descripcion="Catálogo de materias por grado, con los docentes asignados a cada una."         Color="white" Delay="3" Icon="book"         />
            <ModuloCard Href="/evaluaciones"   Titulo="Evaluaciones"  Descripcion="Registro de notas finales y consulta del historial por estudiante."             Color="white" Delay="4" Icon="chart"        />
        </div>
    </div>
</section>

<!-- ═══════════════════════════════════════════════════════
     SECCIÓN: Arquitectura (oscura con highlight)
     ═══════════════════════════════════════════════════════ -->
<section class="section" style="background:#0f172a; color:white;">
    <div class="container">
        <div class="text-center mb-12 reveal">
            <span class="section-label" style="color:#3b82f6;">Arquitectura</span>
            <h2 class="section-title" style="color:white;">Diseñado con estándares<br/>de ingeniería de software</h2>
        </div>

        <div class="cards-grid-3">
            <ArqCard Titulo="Observer Pattern" Desc="4 eventos activos que notifican en tiempo real: evaluaciones, alertas de permanencia, cancelaciones y aprobación de grado." Icono="🔔" Delay="1" />
            <ArqCard Titulo="Result&lt;T&gt; Pattern" Desc="Todos los métodos retornan Result<T> para un manejo robusto de errores sin excepciones abruptas ni impresión en consola." Icono="✅" Delay="2" />
            <ArqCard Titulo="Polimorfismo" Desc="Jerarquía Persona → Estudiante (Pregrado/Posgrado) y Docente con implementación de ObtenerRequisitosDeGrado() por tipo." Icono="🧬" Delay="3" />
            <ArqCard Titulo="Inyección de Dependencias" Desc="Servicios desacoplados e inyectados: EstudianteService, EvaluacionService, UniversidadService y más." Icono="💉" Delay="4" />
            <ArqCard Titulo="Matrices y Vectores" Desc="EstudiosPrevios[5,3] y DatosBachillerato[3] implementados como estructuras de datos estáticas en los modelos." Icono="📊" Delay="5" />
            <ArqCard Titulo="Carga desde CSV" Desc="LectorDatosAcademicos carga estudiantes y docentes desde archivos .csv para simular persistencia de base de datos." Icono="📂" Delay="6" />
        </div>
    </div>
</section>

@code {
    private DashboardStats Stats = new();
    protected override void OnInitialized()
    {
        Stats = Facade.ObtenerEstadisticasDashboard();
    }
}
