@inject NavigationManager Nav

<!-- ══════════════════════════════════════════════════════════
     NAVBAR INSTITUCIONAL — Sistema Académico
     ══════════════════════════════════════════════════════════ -->
<nav class="navbar" id="main-navbar">
    <div class="navbar-inner">

        <!-- Logo -->
        <a class="navbar-brand" href="/">
            <span class="brand-label">Universidad</span>
            <span class="brand-name">Sistema<span>Acad</span></span>
        </a>

        <!-- Navegación principal -->
        <ul class="navbar-nav">
            <li class="nav-item">
                <a href="/" class="@GetLinkClass("/")">
                    <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                    </svg>
                    Inicio
                </a>
            </li>
            <li class="nav-item">
                <a href="/estudiantes" class="@GetLinkClass("/estudiantes")">
                    <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M12 14l9-5-9-5-9 5 9 5z M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
                    </svg>
                    Estudiantes
                </a>
            </li>
            <li class="nav-item">
                <a href="/docentes" class="@GetLinkClass("/docentes")">
                    <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                    </svg>
                    Docentes
                </a>
            </li>
            <li class="nav-item">
                <a href="/asignaturas" class="@GetLinkClass("/asignaturas")">
                    <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                    </svg>
                    Asignaturas
                </a>
            </li>
            <li class="nav-item">
                <a href="/evaluaciones" class="@GetLinkClass("/evaluaciones")">
                    <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    Evaluaciones
                </a>
            </li>
            <li class="nav-item">
                <a href="/operaciones" class="@GetLinkClass("/operaciones")">
                    <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                    </svg>
                    Operaciones
                </a>
            </li>
        </ul>

        <!-- Acciones -->
        <div class="navbar-actions">
            <button class="navbar-toggle" aria-label="Menú">
                <span></span><span></span><span></span>
            </button>
        </div>
    </div>
</nav>

@code {
    private string GetLinkClass(string href)
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri);
        var cleanPath = "/" + path.Split('?')[0].TrimStart('/');
        return (href == "/" ? cleanPath == "/" : cleanPath.StartsWith(href))
            ? "active" : "";
    }
}
