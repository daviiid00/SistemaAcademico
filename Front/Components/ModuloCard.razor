<!-- Tarjeta de módulo reutilizable -->
@if (Color == "blue")
{
    <div class="card card-blue hover-lift reveal animate-delay-@Delay">
        <div class="modulo-icon mb-4">@GetIconSvg(Icon)</div>
        <h3 style="font-size:1.5rem; font-weight:800; color:white; margin-bottom:0.75rem;">@Titulo</h3>
        <p style="color:rgba(255,255,255,0.75); font-size:0.9rem; line-height:1.7; margin-bottom:1.5rem;">@Descripcion</p>
        <a href="@Href" class="btn btn-white btn-sm">Conoce más →</a>
    </div>
}
else
{
    <div class="card hover-lift reveal animate-delay-@Delay">
        <div class="modulo-icon modulo-icon-light mb-4">@GetIconSvg(Icon)</div>
        <h4 style="font-size:1.1rem; font-weight:700; color:#1e293b; margin-bottom:0.5rem;">@Titulo</h4>
        <p style="color:#64748b; font-size:0.875rem; line-height:1.7; margin-bottom:1.25rem; flex:1;">@Descripcion</p>
        <a href="@Href" class="btn btn-outline btn-sm">Ir al módulo →</a>
    </div>
}

<style>
    .modulo-icon {
        width: 48px;
        height: 48px;
        background: rgba(255,255,255,0.15);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
    }

    .modulo-icon-light {
        background: #eff6ff;
        color: #1a56db;
    }
</style>

@code {
    [Parameter] public string Href         { get; set; } = "/";
    [Parameter] public string Titulo       { get; set; } = "";
    [Parameter] public string Descripcion  { get; set; } = "";
    [Parameter] public string Color        { get; set; } = "white"; // "blue" | "white"
    [Parameter] public string Icon         { get; set; } = "star";
    [Parameter] public int    Delay        { get; set; } = 1;

    private MarkupString GetIconSvg(string icon) => icon switch
    {
        "academic-cap" => new MarkupString(@"<svg width='24' height='24' fill='none' viewBox='0 0 24 24' stroke='currentColor'>
            <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2'
              d='M12 14l9-5-9-5-9 5 9 5z M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z'/>
        </svg>"),
        "user" => new MarkupString(@"<svg width='24' height='24' fill='none' viewBox='0 0 24 24' stroke='currentColor'>
            <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2'
              d='M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z'/>
        </svg>"),
        "book" => new MarkupString(@"<svg width='24' height='24' fill='none' viewBox='0 0 24 24' stroke='currentColor'>
            <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2'
              d='M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253'/>
        </svg>"),
        "chart" => new MarkupString(@"<svg width='24' height='24' fill='none' viewBox='0 0 24 24' stroke='currentColor'>
            <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2'
              d='M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z'/>
        </svg>"),
        _ => new MarkupString(@"<svg width='24' height='24' fill='none' viewBox='0 0 24 24' stroke='currentColor'>
            <path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z'/>
        </svg>")
    };
}
